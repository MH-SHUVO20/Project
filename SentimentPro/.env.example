# ─── SentimentPro Environment ───────────────────────
# Copy this file to .env and fill in the values.

APP_NAME=SentimentPro API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9090,http://127.0.0.1:9090

# ─── Database (PostgreSQL) ──────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sentimentpro
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/sentimentpro

# ─── Auth ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ─── Model Paths ───────────────────────────────────
MODEL_DIR=app/model/banglabert_multitask
TOKENIZER_DIR=app/model/tokenizer
MODEL_MAX_LENGTH=128
NORMALIZER_RESOURCE_DIR=app/Normalizer/resources
